  "components": [
    {
      "name": "Acción principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Botón relleno claro. Muestra HTML; medidas reales en dp/sp y estados nativos en Compose.",
      "html": "<button class=\"ds-primary\">Obtener mi ubicación</button>",
      "css": ".ds-primary{font-family:sans-serif;font-size:14px;font-weight:500;line-height:20px;letter-spacing:.1px;color:#FFFFFF;background:#087768;border:0;border-radius:27px;min-width:240px;height:54px;padding:0 24px;cursor:pointer}.ds-primary:hover{filter:brightness(.97)}.ds-primary:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-primary:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Acción principal nocturna",
      "kind": "button",
      "refersTo": "button-primary-dark",
      "description": "Variante rellena oscura. Muestra HTML del par de color del tema.",
      "html": "<button class=\"ds-primary-dark\">Ver lugares</button>",
      "css": ".ds-primary-dark{font-family:sans-serif;font-size:14px;font-weight:500;line-height:20px;letter-spacing:.1px;color:#00382E;background:#83DAC5;border:0;border-radius:27px;min-width:240px;height:54px;padding:0 24px;cursor:pointer}.ds-primary-dark:hover{filter:brightness(.97)}.ds-primary-dark:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-primary-dark:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-primary-dark{transition:none}}"
    },
    {
      "name": "Acción de cristal",
      "kind": "button",
      "refersTo": "button-glass",
      "description": "Filtro compacto. Muestra del fallback; el HTML no reproduce el shader AGSL ni el mapa.",
      "html": "<button class=\"ds-glass\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16M8 3v6M16 9v6M10 15v6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Todo · 200 m</span><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-glass{font-family:sans-serif;font-size:14px;font-weight:500;line-height:20px;letter-spacing:.1px;display:flex;align-items:center;gap:10px;width:214px;height:52px;padding:0 18px;color:#142D29;border:1px solid rgba(255,255,255,.95);border-radius:32px;background:linear-gradient(135deg,rgba(245,255,250,.85),rgba(245,255,250,.55));cursor:pointer;transition:transform .15s}.ds-glass span{flex:1;text-align:left}.ds-glass svg:last-child{width:16px;height:16px}.ds-glass:hover{filter:brightness(.97)}.ds-glass:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-glass:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-glass{transition:none}}"
    },
    {
      "name": "Ubicación de cristal",
      "kind": "button",
      "refersTo": "icon-glass-location",
      "description": "Control activo con etiqueta accesible; fallback ilustrativo del material.",
      "html": "<button class=\"ds-locate\" aria-label=\"Centrar mi ubicación\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 1v3M12 20v3M1 12h3M20 12h3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-locate{display:grid;place-items:center;width:60px;height:60px;padding:0;color:#087768;border:1px solid rgba(255,255,255,.95);border-radius:32px;background:linear-gradient(135deg,rgba(245,255,250,.85),rgba(245,255,250,.55));cursor:pointer;transition:transform .15s}.ds-locate:hover{filter:brightness(.97)}.ds-locate:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-locate:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-locate{transition:none}}"
    },
    {
      "name": "Categoría seleccionada",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "FilterChip Material 3 con verificación y mínimo táctil; vista HTML representativa.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M4 12l5 5L20 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span>Todo</span></button>",
      "css": ".ds-chip{font-family:sans-serif;font-size:14px;font-weight:500;line-height:20px;letter-spacing:.1px;display:flex;align-items:center;gap:8px;min-height:48px;padding:0 12px;border:0;border-radius:8px;background:#D6EDE6;color:#173E34;cursor:pointer}.ds-chip svg{width:18px;height:18px}.ds-chip:hover{filter:brightness(.97)}.ds-chip:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-chip:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none}}"
    },
    {
      "name": "Radio de cercanía",
      "kind": "custom",
      "refersTo": "radius-segment",
      "description": "Tres opciones nativas de elección única; muestra estática del estado 200 m.",
      "html": "<div class=\"ds-radius\" role=\"group\" aria-label=\"Radio de cercanía\"><button class=\"ds-radio\" aria-pressed=\"false\">100 m</button><button class=\"ds-radio ds-radio-selected\" aria-pressed=\"true\">200 m</button><button class=\"ds-radio\" aria-pressed=\"false\">500 m</button></div>",
      "css": ".ds-radius{display:flex;width:320px;height:54px}.ds-radio{font-family:sans-serif;font-size:14px;font-weight:500;line-height:20px;letter-spacing:.1px;flex:1;min-width:48px;border:0;border-radius:28px;background:transparent;color:#142D29;cursor:pointer}.ds-radio-selected{color:#087768;background:linear-gradient(135deg,rgba(245,255,250,.85),rgba(245,255,250,.55));border:1px solid white}.ds-radio:hover{filter:brightness(.97)}.ds-radio:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-radio:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-radio{transition:none}}"
    },
    {
      "name": "Fila de lugar",
      "kind": "button",
      "refersTo": "place-row",
      "description": "Lugar cercano; nombre y distancia se reparten espacio, sin ancho de texto fijo.",
      "html": "<button class=\"ds-place\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path d=\"M3 4h7a3 3 0 0 1 3 3v14a4 4 0 0 0-3-2H3V4ZM13 7a3 3 0 0 1 3-3h5v15h-5a4 4 0 0 0-3 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><span class=\"ds-place-copy\"><strong>Biblioteca Central</strong><small>Estudio · En el radio</small></span><span class=\"ds-distance\">88 m</span></button>",
      "css": ".ds-place{display:flex;align-items:center;gap:12px;width:360px;max-width:100%;min-height:72px;padding:10px;border:0;border-radius:12px;color:#087768;background:transparent;text-align:left;cursor:pointer;font-family:sans-serif}.ds-place svg{width:25px;height:25px;flex:none}.ds-place-copy{flex:1;min-width:0}.ds-place-copy strong{display:block;padding-right:12px;font-size:16px;line-height:24px;font-weight:600;letter-spacing:.5px}.ds-place-copy small{display:block;font-size:12px;line-height:16px;letter-spacing:.4px;color:#44625C}.ds-distance{flex:0 0 64px;margin-left:8px;text-align:right;font-size:14px;line-height:20px;font-weight:600;color:#142D29}.ds-place:hover{filter:brightness(.97)}.ds-place:focus-visible{outline:3px solid #69847C;outline-offset:3px}.ds-place:active{transform:scale(.945)}@media(prefers-reduced-motion:reduce){.ds-place{transition:none}}"
    },
    {
      "name": "Panel de lugares",
      "kind": "card",
      "refersTo": "places-sheet",
      "description": "Centro mate de lectura. Muestra HTML sin mapa; la profundidad nativa no equivale a box-shadow CSS.",
      "html": "<section class=\"ds-sheet\"><span class=\"ds-handle\" aria-hidden=\"true\"></span><div class=\"ds-sheet-head\"><strong>Cerca de ti</strong><span>5 lugares</span></div><p>Ubicación lista</p></section>",
      "css": ".ds-sheet{width:320px;max-width:100%;padding:0 20px 20px;border-radius:30px;border:1px solid rgba(255,255,255,.95);color:#142D29;background:linear-gradient(135deg,rgba(245,255,250,.97),rgba(245,255,250,.94));font-family:sans-serif}.ds-handle{display:block;width:36px;height:4px;margin:8px auto 7px;background:#CCDFD7;border-radius:2px}.ds-sheet-head{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px}.ds-sheet-head strong{font-size:22px;font-weight:700;line-height:28px}.ds-sheet-head span{font-size:14px;line-height:20px;font-weight:500;color:#44625C}.ds-sheet p{font-size:12px;line-height:16px;font-weight:500;color:#087768}"
    }
  ],
  "narrative": {
    "northStar": "Verde agua y vidrio claro",
    "overview": "La dirección confirmada por Daniella combina blanco frío, verde agua profundo y cristal legible. La interfaz es sobria y táctil: el mapa real conserva su detalle y las superficies flotantes reúnen acciones breves. Los rótulos y los iconos permanecen nítidos sobre el material.\n\nEste documento describe el código Android de fase 2, no una implementación iOS ni un material nativo de Apple. Kotlin, Compose y Material 3 son la autoridad. Los lugares son ficticios; la ilustración inicial no es una fotografía ni un plano del campus. No hay login ni perfil.",
    "keyCharacteristics": [
      "Verde agua para acciones y estado, con equivalentes explícitos de noche.",
      "Cristal ligero en controles y centro mate en superficies de lectura.",
      "Tipografía Material 3, iconos vectoriales de trazo redondeado y áreas táctiles cómodas.",
      "Una misma información accesible desde el mapa y la lista."
    ],
    "rules": [
      {
        "name": "The Estado legible Rule",
        "body": "Acompañar el color de selección, cercanía o radio con texto, marca, semántica de estado o tamaño; el color solo no basta.",
        "section": "colors"
      },
      {
        "name": "The Tacto cómodo Rule",
        "body": "Mantener objetivos de al menos 48 × 48; botones rellenos y radio miden 54 de alto, vidrio 52, ubicación 60, tema 52 y filas al menos 72. Conservar etiquetas accesibles y crecimiento del texto.",
        "section": "layout"
      },
      {
        "name": "The Lectura sobre vidrio Rule",
        "body": "Reservar el centro mate para información sostenida; la transparencia y el brillo nunca sustituyen el contraste del contenido.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reutilizar los pares semánticos claro/oscuro de `CampusGPSTheme` y mantener contenido legible sobre el material.",
      "**Do** conservar objetivos táctiles de 48 dp o mayores, texto escalable y descripciones de iconos.",
      "**Do** mantener estados con texto o marcas, además del color.",
      "**Do** preservar fallback sin shader, atribución del mapa y procedencia de la ilustración."
    ],
    "donts": [
      "**Don't** reemplazar el mapa real o sus rótulos por una imagen generada, texto superpuesto o un plano ficticio.",
      "**Don't** convertir transparencia, brillo o animación permanente en requisito de lectura.",
      "**Don't** presentar la ilustración o los lugares de ejemplo como información de un campus real.",
      "**Don't** tratar capturas de emulador como garantía de todos los dispositivos, ni convertir solapamientos de texto o atribución compacta en patrones nuevos."
    ]
  }
}
